<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃课程药丸: 垂直 alpha 渐变 (顶密底透) —— setBackgroundTintList 的 SRC_IN 只替换
     RGB、保留 alpha 模式, 所以一个 drawable 配运行时 tint 即得"顶部微亮"的玻璃药丸,
     无需再出 12 色板 × 深浅的整套文件 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#FFFFFFFF"
        android:endColor="#C7FFFFFF" />
    <corners android:radius="11dp" />
</shape>
