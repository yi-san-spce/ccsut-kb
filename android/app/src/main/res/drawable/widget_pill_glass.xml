<?xml version="1.0" encoding="utf-8"?>
<!-- 液态玻璃课程药丸: 垂直 alpha 渐变 (顶 75% → 底 40%) + 1dp 60% 描边 —— setBackgroundTintList
     的 SRC_IN 只替换 RGB、保留 alpha 模式, 所以一个 drawable 配课程色全 alpha tint 即得
     "顶部亮缘 + 明显透底 + 同色系细边"的玻璃药丸, 无需再出 12 色板 × 深浅的整套文件 -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <gradient
        android:angle="270"
        android:startColor="#BFFFFFFF"
        android:endColor="#66FFFFFF" />
    <stroke
        android:width="1dp"
        android:color="#99FFFFFF" />
    <corners android:radius="11dp" />
</shape>
