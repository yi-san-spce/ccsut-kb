<?xml version="1.0" encoding="utf-8"?>
<!-- L/XL 档 (≈3×3 及以上): 标题 + 下节课 + 可滚动议程列表(今天+后续按天分组) / 空态居中 + 底部行。
     ListView + RemoteCollectionItems 在所有桌面原生可滚, 手指上下滑看后续课程。
     根节点必须用框架 @RemoteView 视图 (CardView 无注解在 launcher 端会 InflateException);
     阴影轮廓由 background 18dp 圆角提供, 玻璃位图画在背景之上 -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@android:style/Theme.DeviceDefault.DayNight"
    android:clipToOutline="true"
    android:elevation="5dp"
    android:background="@drawable/widget_bg">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/w_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/w_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="第4周 · 周三"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02"
                    android:textColor="@android:color/system_neutral1_900"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/w_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="10.25"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@android:color/system_neutral2_700" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="1dp"
                android:text="下节课 8:20 · 高等数学"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#59000000"
                android:shadowRadius="3"
                android:shadowDy="1"
                android:textColor="@android:color/system_accent1_400"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- 中部: 有课=可滚动议程, 无课=大字空态(居中) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="3dp">

                <ListView
                    android:id="@+id/w_agenda"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:divider="@drawable/widget_divider"
                    android:dividerHeight="6dp"
                    android:scrollbars="none"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/w_empty_box"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/w_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今天没有课"
                        android:textSize="22sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.04"
                        android:textColor="@android:color/system_neutral1_900" />

                    <TextView
                        android:id="@+id/w_empty_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="好好休息"
                        android:textSize="13sp"
                        android:letterSpacing="0.08"
                        android:textColor="@android:color/system_neutral2_700" />
                </LinearLayout>
            </FrameLayout>

            <!-- 空态/期末降级时显示 (有课时隐藏) -->
            <TextView
                android:id="@+id/w_bottom_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="4dp"
                android:text="下一次 周一(10/27) 8:20 · 高等数学"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#59000000"
                android:shadowRadius="3"
                android:shadowDy="1"
                android:textColor="@android:color/system_accent1_400"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</FrameLayout>
