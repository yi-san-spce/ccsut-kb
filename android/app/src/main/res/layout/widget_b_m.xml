<?xml version="1.0" encoding="utf-8"?>
<!-- M 档 (≈2×2 / 3×2 标准): 标题 + 下节课 + 课程药丸(固定行数) / 空态居中 + 底部「下一次课」行 -->
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:theme="@android:style/Theme.DeviceDefault.DayNight"
    android:clipToOutline="true"
    app:cardCornerRadius="18dp"
    app:cardElevation="5dp"
    app:cardBackgroundColor="#ECEBF1">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/w_glass"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:visibility="gone"
            android:contentDescription="@null" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="11dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/w_title"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="第4周 · 周三"
                    android:textSize="16sp"
                    android:fontFamily="sans-serif-black"
                    android:letterSpacing="0.02"
                    android:textColor="@android:color/system_neutral1_900"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <TextView
                    android:id="@+id/w_date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="10.25"
                    android:textSize="12sp"
                    android:letterSpacing="0.05"
                    android:fontFeatureSettings="tnum"
                    android:textColor="@android:color/system_neutral2_700" />
            </LinearLayout>

            <TextView
                android:id="@+id/w_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="下节课 8:20 · 高等数学"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#59000000"
                android:shadowRadius="3"
                android:shadowDy="1"
                android:textColor="@android:color/system_accent1_400"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <!-- 中部: 有课=药丸列表(顶部对齐), 无课=大字空态(居中) -->
            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="7dp">

                <LinearLayout
                    android:id="@+id/w_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:showDividers="middle"
                    android:divider="@drawable/widget_divider">

                    <include layout="@layout/widget_item" />
                    <include layout="@layout/widget_item" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/w_empty_box"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/w_empty_title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="今天没有课"
                        android:textSize="20sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.04"
                        android:textColor="@android:color/system_neutral1_900" />

                    <TextView
                        android:id="@+id/w_empty_sub"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="3dp"
                        android:text="好好休息"
                        android:textSize="13sp"
                        android:letterSpacing="0.08"
                        android:textColor="@android:color/system_neutral2_700" />
                </LinearLayout>
            </FrameLayout>

            <!-- 空态/全天结束时的「下一次课」强调行 (有课时隐藏) -->
            <TextView
                android:id="@+id/w_bottom_next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:paddingStart="4dp"
                android:text="下一次 周一(10/27) 8:20 · 高等数学"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:shadowColor="#59000000"
                android:shadowRadius="3"
                android:shadowDy="1"
                android:textColor="@android:color/system_accent1_400"
                android:maxLines="1"
                android:ellipsize="end"
                android:visibility="gone" />

            <TextView
                android:id="@+id/w_more"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:paddingStart="4dp"
                android:text="还有 2 门课…"
                android:textSize="12sp"
                android:textColor="@android:color/system_neutral2_700"
                android:maxLines="1"
                android:visibility="gone" />
        </LinearLayout>
    </FrameLayout>
</androidx.cardview.widget.CardView>
